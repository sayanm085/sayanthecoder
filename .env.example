# Production canonical origin. Defaults to https://www.sayanthecoder.in.
# Override only when the public production domain changes.
SITE_URL=https://www.sayanthecoder.in

# Optional verification tokens from the property owner; not OAuth credentials.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional GA4. First disable ALL Enhanced Measurement in the GA4 web stream.
# Automated outbound-link/form tracking could collect private Gmail/WhatsApp URLs.
# Then add the real public web-stream ID and enable this explicit setup gate.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GA4_MANUAL_MEASUREMENT=false
